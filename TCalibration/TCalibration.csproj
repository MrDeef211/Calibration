<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	<TrimMode>full</TrimMode>
	<InvariantGlobalization>true</InvariantGlobalization>
	<Configurations>Debug;Release;Visual</Configurations>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Visual'">
		<DefineConstants>$(DefineConstants);VISUAL</DefineConstants>
	</PropertyGroup>


	<ItemGroup>
    <ProjectReference Include="..\MathTool\MathTool.csproj" />
    <ProjectReference Include="..\Visualization\Visualization.csproj" />
  </ItemGroup>

</Project>
